{
  "$schema": "node_modules/wrangler/config-schema.json",
  // SANDBOX ONLY — never point this config at production Workers/domains
  "name": "test0chnkukoolwal0vc",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Pure Worker-origin: Cloudflare manages DNS + certs for this hostname.
  "routes": [
    {
      "pattern": "test.chnkukoolwal.vc",
      "custom_domain": true
    }
  ],
  // Static site files. Worker runs first for dynamic paths, then falls through to assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/health", "/kv-demo", "/mcp", "/mcp/*"]
  },
  // Sandbox-only KV. Do not bind production token namespaces here.
  "kv_namespaces": [
    {
      "binding": "FLAGS",
      "id": "f3c9868bfc224fa68604ae98576dddd2"
    }
  ],
  // Workers Logs — sandbox only. Lets Cursor/Cloudflare query request logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
